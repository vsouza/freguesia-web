<Layouts.app flash={@flash}>
  <section class="flex min-h-[70dvh] flex-col justify-between gap-10 pt-10" id="welcome">
    <div class="flex flex-1 flex-col justify-end gap-6 rounded-sheet bg-linear-to-b from-cat-peach-top to-white p-8">
      <FreguesiaWeb.Components.two_line_title
        first={gettext("Order direct.")}
        second={gettext("Pay the regular's price.")}
      />
    </div>

    <div class="flex flex-col gap-3">
      <.link
        id="get-started"
        href={~p"/start"}
        class="inline-flex min-h-12 items-center justify-center rounded-full bg-ink px-6 text-base font-bold text-white hover:bg-ink-2"
      >
        {gettext("Get started")}
      </.link>
      <.link
        id="own-restaurant"
        navigate={~p"/business/register"}
        class="text-center text-sm font-bold text-ink-2 underline underline-offset-4"
      >
        {gettext("I own a restaurant")}
      </.link>
    </div>
  </section>
</Layouts.app>
