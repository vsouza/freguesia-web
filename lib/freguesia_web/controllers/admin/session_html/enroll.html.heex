<Layouts.admin flash={@flash}>
  <div class="mx-auto mt-10 flex max-w-md flex-col gap-6 rounded-card bg-white p-8 shadow-card">
    <div>
      <p class="text-xs font-bold uppercase tracking-wide text-muted">Primeiro acesso</p>
      <h1 class="mt-1 text-2xl font-extrabold tracking-tight">Cadastre o app</h1>
      <p class="mt-2 text-sm text-ink-2">
        O 2FA é obrigatório no backoffice. Escaneie o QR com um app autenticador
        (Google Authenticator, 1Password, Authy) e digite o código que ele mostrar.
      </p>
    </div>

    <div class="flex flex-col items-center gap-3">
      <div
        id="totp-qr"
        class="rounded-tile bg-white p-3 ring-1 ring-line"
        role="img"
        aria-label="QR code para o app autenticador"
      >
        <.qr_code svg={@qr_svg} />
      </div>
      <p class="text-xs text-muted">Sem câmera? Digite a chave:</p>
      <code
        id="totp-secret"
        class="rounded-tile bg-sand px-3 py-2 text-sm font-bold tracking-wider"
      >
        {@secret}
      </code>
    </div>

    <.form
      for={@form}
      id="enroll-form"
      action={~p"/admin/entrar/cadastrar-2fa"}
      class="flex flex-col gap-1"
    >
      <.input
        field={@form[:code]}
        type="text"
        label="Código do app"
        inputmode="numeric"
        autocomplete="one-time-code"
        maxlength="6"
        required
      />
      <div class="mt-3">
        <.button type="submit" id="enroll-submit" class="w-full">Confirmar e entrar</.button>
      </div>
    </.form>
  </div>
</Layouts.admin>
